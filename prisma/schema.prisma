generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model User {
  id             Int                @id @default(autoincrement())
  email          String             @unique
  password       String?            // ← antes era obligatorio; ahora opcional
  name           String
  createdAt      DateTime           @default(now())
  perks          Int                @default(0)
  resetToken     String?            @unique
  resetTokenExp  DateTime?
  canjes         Canje[]
  activo         Boolean            @default(true)
}

model Perk {
  nombre      String
  descripcion String
  puntos      Int
  imagen      String?
  createdAt   DateTime @default(now())
  id          Int      @id @default(autoincrement())
  canjes      Canje[]
}

model Canje {
  usuarioId Int
  estado    String   @default("pendiente")
  fecha     DateTime @default(now())
  id        Int      @id @default(autoincrement())
  perkId    Int
  perk      Perk     @relation(fields: [perkId], references: [id])
  usuario   User     @relation(fields: [usuarioId], references: [id])
}

model Admin {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())

  comunicados Comunicado[]
}

model Comunicado {
  id              Int      @id @default(autoincrement())
  titulo          String
  contenido       String
  tipo            String   @default("informativo") // "urgente", "novedad", etc.
  linkExterno     String?                         // URL opcional
  imagen          String?                         // Ruta o URL a imagen
  destacado       Boolean  @default(false)         // Fijar arriba
  visible         Boolean  @default(true)          // Mostrar/ocultar
  fecha           DateTime @default(now())         // Fecha de publicación
  fechaCaducidad  DateTime?                        // Hasta cuándo es válido
  creadoPorId     Int
  creadoPor       Admin    @relation(fields: [creadoPorId], references: [id])

  @@index([fecha])
  @@index([fechaCaducidad])
}

